# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
.pytest_cache/
.coverage
htmlcov/

# Logs
*.log
app_debug.log
metrics_history.log

# IDEs
.idea/
.vscode/
*.swp
*.swo

settings.json

# Build artifacts (PyInstaller)
dist/
build/
*.spec
# ...except the build recipe. An untracked spec is an unreproducible build:
# the exe can only be rebuilt from whoever's checkout happens to hold it, not
# from the repository. This one is the entire description of the build, so it
# is tracked on purpose.
!Monitor.spec
*.exe
*.bin

# OS
Thumbs.db
desktop.ini
.DS_Store

# Superpowers scratch (brainstorm mockups, playwright snapshots)
.superpowers/
.playwright-mcp/
shot-*.png
